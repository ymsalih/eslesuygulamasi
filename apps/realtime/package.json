{
  "name": "@sark/realtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts --dev",
    "start": "node dist/index.js",
    "build": "esbuild src/index.ts src/migrate.ts --bundle --platform=node --format=esm --target=node20 --outdir=dist --packages=external --alias:@sark/shared/server=../../packages/shared/src/server/index.ts --alias:@sark/shared=../../packages/shared/src/index.ts",
    "db:migrate": "tsx src/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sark/shared": "*",
    "pg": "^8.13.0",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "esbuild": "^0.25.0",
    "socket.io-client": "^4.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
